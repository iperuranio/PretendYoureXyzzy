# Random and permanent: changing it invalidates every player's identification code.
# Generate with: openssl rand -hex 32
PYX_ID_CODE_SALT=
# Host name the game is served from (cookies are scoped to it).
PYX_COOKIE_DOMAIN=xyzzy.example.com
# Optional: comma separated client IPs treated as admins. Default: nobody.
# Write each address exactly as the reverse proxy logs it (IPv6 in its compressed form).
# PYX_ADMIN_ADDRS=
