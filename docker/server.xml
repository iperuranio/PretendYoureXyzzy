<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal Tomcat for a single app behind a reverse proxy: no shutdown port, no manager,
     no default apps, no version in error pages. -->
<Server port="-1" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />
  <Service name="Catalina">
    <!-- Every connected player holds one thread in a long poll: maxThreads stays above
         pyx.max_users with room for the regular requests. -->
    <Connector port="8080" protocol="HTTP/1.1" connectionTimeout="20000" maxThreads="250"
               server="xyzzy" />
    <Engine name="Catalina" defaultHost="localhost">
      <!-- Takes the client address from X-Real-IP, which the reverse proxy overwrites with the
           peer it sees (X-Forwarded-For is not used: its entries can be written by the client).
           The header is honoured only when the request comes from a private address (the default
           internalProxies). Also marks requests as secure when the proxy says https. -->
      <Valve className="org.apache.catalina.valves.RemoteIpValve"
             remoteIpHeader="x-real-ip" protocolHeader="x-forwarded-proto" />
      <Host name="localhost" appBase="webapps" unpackWARs="false" autoDeploy="false">
        <Valve className="org.apache.catalina.valves.ErrorReportValve"
               showReport="false" showServerInfo="false" />
      </Host>
    </Engine>
  </Service>
</Server>
